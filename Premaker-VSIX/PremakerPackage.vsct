<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<Extern href="stdidcmd.h" />
	<Extern href="vsshlids.h" />

	<Commands package="guidPremakerPackage">

		<Menus>
			<Menu guid="guidPremakerPackageCmdSet" id="PremakeToolbar" type="Toolbar">
				<CommandFlag>DefaultDocked</CommandFlag>
				<Strings>
					<ButtonText>Premaker</ButtonText>
					<CommandName>Premaker</CommandName>
				</Strings>
			</Menu>

			<Menu guid="guidPremakerPackageCmdSet" id="PremakeSubmenu" type="Menu">
				<Parent guid="guidPremakerPackageCmdSet" id="MyMenuGroup" />
				<Strings>
					<ButtonText>Premake</ButtonText>
					<CommandName>Premake</CommandName>
				</Strings>
			</Menu>
			<Menu guid="guidPremakerPackageCmdSet" id="PremakeVersionSubmenu" type="Menu">
				<Parent guid="guidPremakerPackageCmdSet" id="MyMenuGroup" />
				<Strings>
					<ButtonText>Version</ButtonText>
					<CommandName>Version</CommandName>
				</Strings>
			</Menu>

		</Menus>

		<Groups>
			<!-- Toolbar group -->
			<Group guid="guidPremakerPackageCmdSet" id="MyMenuGroup" priority="0x0000">
				<Parent guid="guidPremakerPackageCmdSet" id="PremakeToolbar" />
			</Group>

			<!-- Tools menu group -->
			<Group guid="guidPremakerPackageCmdSet" id="MyMenuGroup" priority="0x0600">
				<Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
			</Group>

			<!-- Solution node context menu -->
			<Group guid="guidPremakerPackageCmdSet" id="MyMenuGroup" priority="0x0050">
				<Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_SOLNNODE" />
			</Group>

			<!-- View menu group for your Tool Window -->
			<!-- FIX: Use a new unique group id (e.g. MyToolWindowGroup) instead of reusing MyMenuGroup -->
			<Group guid="guidPremakerPackageCmdSet" id="MyToolWindowGroup" priority="0x0600">
				<Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_VIEW" />
			</Group>

			<Group guid="guidPremakerPackageCmdSet" id="PremakeSubmenuGroup" priority="0x0100">
				<Parent guid="guidPremakerPackageCmdSet" id="PremakeSubmenu" />
			</Group>

			<Group guid="guidPremakerPackageCmdSet" id="PremakeVersionSubmenuGroup" priority="0x0200">
				<Parent guid="guidPremakerPackageCmdSet" id="PremakeVersionSubmenu" />
			</Group>


		</Groups>

		<Buttons>
			<!-- Run Premake button -->
			<Button guid="guidPremakerPackageCmdSet" id="RunCommandId" priority="0x0100" type="Button">
				<Parent guid="guidPremakerPackageCmdSet" id="PremakeSubmenuGroup" />
				<Icon guid="guidIcon" id="bmpIcon" />
				<Strings>
					<ButtonText>Run Premake</ButtonText>
				</Strings>
			</Button>

			<!-- Premake Terminal Tool Window button -->
			<Button guid="guidPremakerPackageCmdSet" id="PremakeTerminalCommandId" priority="0x0100" type="Button">
				<!-- FIX: Parent is the new group id (MyToolWindowGroup) to put it under View menu -->
				<Parent guid="guidPremakerPackageCmdSet" id="MyToolWindowGroup" />
				<Icon guid="guidIcon" id="bmpIcon" />
				<Strings>
					<ButtonText>Premake Terminal</ButtonText>
				</Strings>
			</Button>
		  <Button guid="guidPremakerPackageCmdSet" id="cmdidToolWindow1Command" priority="0x0100" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
        <Icon guid="guidImages" id="bmpPic1" />
        <Strings>
          <ButtonText>ToolWindow1</ButtonText>
        </Strings>
      </Button>
   
      <Button guid="guidPremakerPackageCmdSet" id="cmdidVersionListAvailable" priority="0x0200" type="Button">
        <Parent guid="guidPremakerPackageCmdSet" id="PremakeVersionSubmenuGroup" />
		<Strings>
			<ButtonText>List Releases</ButtonText>
        </Strings>
      </Button>
    </Buttons>

		<Bitmaps>
			<Bitmap guid="guidIcon" href="Resources\favicon.ico" usedList="bmpIcon" />
      <Bitmap guid="guidImages1" href="Resources\PremakeManagerWindowCommand.png" usedList="bmpPic1, bmpPic2, bmpPicSearch, bmpPicX, bmpPicArrows, bmpPicStrikethrough" />
    </Bitmaps>

	</Commands>

	<Symbols>
		<GuidSymbol name="guidPremakerPackage" value="{5fca1048-f29c-4275-8ae0-f63e174fcf7d}" />

		<GuidSymbol name="guidPremakerPackageCmdSet" value="{efa1febb-39cc-4455-8d50-1b50fe3c5e5c}">
			<IDSymbol name="PremakeToolbar" value="0x1000" />
			<IDSymbol name="MyMenuGroup" value="0x1020" />
			<IDSymbol name="MyToolWindowGroup" value="0x1021" />
			<!-- New group ID for View menu -->
			<IDSymbol name="RunCommandId" value="0x0100" />
			<IDSymbol name="PremakeTerminalCommandId" value="0x0200" />
			<IDSymbol value="4130" name="cmdidToolWindow1Command" />
			<IDSymbol name="PremakeSubmenu" value="0x2000" />
			<IDSymbol name="PremakeSubmenuGroup" value="0x2001" />

			<IDSymbol name="PremakeVersionSubmenu" value="0x2100" />
			<IDSymbol name="PremakeVersionSubmenuGroup" value="0x2101" />
			<IDSymbol value="4131" name="cmdidPremakeManagerWindowCommand" />
			<IDSymbol value="8450" name="cmdidVersionListAvailable" />
    </GuidSymbol>

		<GuidSymbol name="guidIcon" value="{8F26FB35-30AA-4D08-AD0D-79E68119DF4B}">
			<IDSymbol name="bmpIcon" value="1" />
		</GuidSymbol>
	
    <GuidSymbol value="{0b936da1-7d6e-4abd-a2c1-8d2d7316549e}" name="guidImages">
      <IDSymbol name="bmpPic1" value="1" />
      <IDSymbol name="bmpPic2" value="2" />
      <IDSymbol name="bmpPicSearch" value="3" />
      <IDSymbol name="bmpPicX" value="4" />
      <IDSymbol name="bmpPicArrows" value="5" />
      <IDSymbol name="bmpPicStrikethrough" value="6" />
    </GuidSymbol>
  
    <GuidSymbol value="{084eef42-e0fe-4494-a399-200f3ab1bed9}" name="guidImages1">
      <IDSymbol name="bmpPic1" value="1" />
      <IDSymbol name="bmpPic2" value="2" />
      <IDSymbol name="bmpPicSearch" value="3" />
      <IDSymbol name="bmpPicX" value="4" />
      <IDSymbol name="bmpPicArrows" value="5" />
      <IDSymbol name="bmpPicStrikethrough" value="6" />
    </GuidSymbol>
  
    <GuidSymbol value="{97a7fa1c-0bb7-49c3-8207-66b49544a100}" name="guidImages2">
      <IDSymbol name="bmpPic1" value="1" />
      <IDSymbol name="bmpPic2" value="2" />
      <IDSymbol name="bmpPicSearch" value="3" />
      <IDSymbol name="bmpPicX" value="4" />
      <IDSymbol name="bmpPicArrows" value="5" />
      <IDSymbol name="bmpPicStrikethrough" value="6" />
